# Backend Settings
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Database=SmartOfferDB;Username=postgres;Password=postgres

# JWT Authentication
Jwt__Key=super_secret_key_for_jwt_token_auth_which_must_be_long
Jwt__Issuer=SmartOfferApp
Jwt__Audience=SmartOfferUsers

# Frontend Settings
REACT_APP_API_URL=http://localhost:5000/api

DB_HOST=localhost
DB_PORT=5432
DB_NAME=SmartOffer
DB_USER=postgres
DB_PASSWORD=root

JWT_SECRET=your_secret
JWT_EXPIRY=60