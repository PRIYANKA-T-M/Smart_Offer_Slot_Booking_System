{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=smartoffer_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "super_secret_key_needs_to_be_long_enough_for_hmac256",
    "Issuer": "SmartOfferApi",
    "Audience": "SmartOfferClients"
  }
}
